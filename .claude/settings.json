{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Skill",
      "Agent",
      "WebSearch",
      "WebFetch(domain:*)",
      "Bash(python -m vigie *)",
      "Bash(.venv/Scripts/python -m vigie *)",
      "Bash(.venv/bin/python -m vigie *)",
      "Bash(vigie *)",
      "Bash(vigie.bat *)",
      "Bash(python -m podia_formation *)",
      "Bash(.venv/Scripts/python -m podia_formation *)",
      "Bash(.venv/bin/python -m podia_formation *)",
      "Bash(formation *)",
      "Bash(formation.bat *)",
      "Bash(python -m pytest *)",
      "Bash(.venv/Scripts/python -m pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(pytest *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Edit(/formation/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ]
  }
}
